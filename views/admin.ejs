<%- include('partials/header') %>

<style>
  .admin-product-img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #dee2e6;
  }

  .admin-table input,
  .admin-table textarea {
    min-width: 120px;
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Admin Dashboard</h1>
  <a href="/" class="btn btn-outline-secondary">← Back to Store</a>
</div>

<div class="row g-4">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="h5">Add Product</h2>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

        <form action="/admin/products" method="POST" enctype="multipart/form-data" class="d-grid gap-2 mt-3">
          <input class="form-control" name="name" placeholder="Product name" required>
          <textarea class="form-control" name="description" placeholder="Description" required></textarea>
          <input class="form-control" name="category" placeholder="Category" value="General" required>
          <input class="form-control" name="price" type="number" step="0.01" placeholder="Price" required>
          <input class="form-control" name="stock" type="number" placeholder="Stock" required>
          <label class="form-label mb-0">Upload product image</label>
          <input class="form-control" name="image_file" type="file" accept="image/*">
          <div class="text-center text-muted small">or</div>
          <input class="form-control" name="image_url" placeholder="Image URL">
          <button class="btn btn-primary">Save Product</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-7">
    <div class="card shadow-sm mb-4">
      <div class="card-body p-4">
        <h2 class="h5">Recent Orders</h2>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Total</th>
                <th>Payment</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
            <% orders.forEach(order => { %>
              <tr>
                <td><%= order.id %></td>
                <td>
                  <%= order.customer_name %><br>
                  <small class="text-muted"><%= order.customer_email %></small>
                </td>
                <td>$<%= Number(order.total_amount).toFixed(2) %></td>
                <td>
                  <div><%= order.payment_method || '-' %></div>
                  <small class="text-muted"><%= order.payment_reference || '' %></small>
                </td>
                <td><span class="badge text-bg-success"><%= order.status %></span></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="h5">Products</h2>
        <div class="table-responsive">
          <table class="table align-middle admin-table">
            <thead>
              <tr>
                <th>Image</th>
                <th>Details</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th style="width: 180px;">Actions</th>
              </tr>
            </thead>
            <tbody>
            <% products.forEach(product => { %>
              <tr>
                <form action="/admin/products/<%= product.id %>/update" method="POST" enctype="multipart/form-data">
                  <td>
                    <img
                      class="admin-product-img mb-2"
                      src="<%= product.image_url || 'https://via.placeholder.com/150' %>"
                      alt="<%= product.name %>"
                    >
                    <input class="form-control form-control-sm mb-2" name="image_url" value="<%= product.image_url || '' %>" placeholder="Image URL">
                    <input class="form-control form-control-sm" name="image_file" type="file" accept="image/*">
                  </td>
                  <td>
                    <input class="form-control form-control-sm mb-2" name="name" value="<%= product.name %>" required>
                    <textarea class="form-control form-control-sm" name="description" rows="3" required><%= product.description %></textarea>
                  </td>
                  <td>
                    <input class="form-control form-control-sm" name="category" value="<%= product.category %>" required>
                  </td>
                  <td>
                    <input class="form-control form-control-sm" name="price" type="number" step="0.01" value="<%= Number(product.price).toFixed(2) %>" required>
                  </td>
                  <td>
                    <input class="form-control form-control-sm" name="stock" type="number" min="0" value="<%= product.stock %>" required>
                  </td>
                  <td>
                    <div class="d-grid gap-2">
                      <button class="btn btn-sm btn-primary" type="submit">Update</button>
                </form>

                    <form action="/admin/products/<%= product.id %>/delete" method="POST" onsubmit="return confirm('Delete this product?');">
                      <button class="btn btn-sm btn-danger w-100" type="submit">Delete</button>
                    </form>
                  </div>
                  </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
