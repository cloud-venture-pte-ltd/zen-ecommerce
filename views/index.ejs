<%- include('partials/header') %>
<div class="hero p-5 mb-4 shadow-sm">
  <h1 class="display-6 fw-bold">Zen E-Shop</h1>
  <p class="lead mb-0">Node.js + Express + MySQL + Docker Compose. Now includes demo card payment flow and product image upload.</p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h4 mb-0">Products</h2>
  <% if (q) { %><span class="badge text-bg-secondary">Search: <%= q %></span><% } %>
</div>

<div class="row g-4">
  <% products.forEach(product => { %>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <img src="<%= product.image_url || 'https://via.placeholder.com/800x500?text=Product' %>" class="card-img-top" alt="<%= product.name %>">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between mb-2">
            <span class="badge text-bg-light"><%= product.category %></span>
            <span class="fw-bold">$<%= Number(product.price).toFixed(2) %></span>
          </div>
          <h5 class="card-title"><%= product.name %></h5>
          <p class="card-text text-muted"><%= product.description %></p>
          <small class="text-muted mb-3">Stock: <%= product.stock %></small>
          <div class="mt-auto d-flex gap-2">
            <a href="/product/<%= product.id %>" class="btn btn-outline-secondary w-50">View</a>
            <form action="/cart/add/<%= product.id %>" method="POST" class="w-50">
              <button class="btn btn-primary w-100" <%= product.stock <= 0 ? 'disabled' : '' %>>Add to Cart</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>
