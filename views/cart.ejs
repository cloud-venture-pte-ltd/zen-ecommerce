<%- include('partials/header') %>
<h1 class="h3 mb-4">Your Cart</h1>
<% if (!cartItems.length) { %>
  <div class="alert alert-info">Your cart is empty.</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="card-body">
      <% cartItems.forEach(item => { %>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom py-3">
          <div class="d-flex align-items-center gap-3">
            <img class="small-img" src="<%= item.image_url || 'https://via.placeholder.com/150' %>" alt="<%= item.name %>">
            <div>
              <h2 class="h6 mb-1"><%= item.name %></h2>
              <div class="text-muted">$<%= Number(item.price).toFixed(2) %> each</div>
            </div>
          </div>
          <form action="/cart/update/<%= item.id %>" method="POST" class="d-flex align-items-center gap-2">
            <input type="number" min="0" name="quantity" value="<%= item.quantity %>" class="form-control" style="width:90px;">
            <button class="btn btn-outline-secondary">Update</button>
          </form>
          <div class="fw-bold">$<%= item.subtotal.toFixed(2) %></div>
          <form action="/cart/remove/<%= item.id %>" method="POST">
            <button class="btn btn-outline-danger">Remove</button>
          </form>
        </div>
      <% }) %>
      <div class="d-flex justify-content-between align-items-center pt-3">
        <h3 class="h5 mb-0">Total: $<%= total.toFixed(2) %></h3>
        <a href="/checkout" class="btn btn-primary">Proceed to Checkout</a>
      </div>
    </div>
  </div>
<% } %>
<%- include('partials/footer') %>
