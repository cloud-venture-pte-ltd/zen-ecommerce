# Application
APP_NAME=Zen E-Commerce
BASE_PATH=

# Database — local development (docker compose)
DATABASE_URL=postgresql://user:password@db:5432/zen_db

# Database — Azure PostgreSQL (use this when connecting to Azure)
# DATABASE_URL=postgresql://zenadmin:YOUR_PASSWORD@zen-postgres-dev.postgres.database.azure.com:5432/zen_db?sslmode=require

# Auth
SESSION_SECRET=change-this-to-a-random-string
ADMIN_EMAIL=admin@zen.com
ADMIN_PASSWORD=change-me

# Payments (mock for local dev, real key for Azure)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# Azure OpenAI (chatbot — leave empty until Week 11)
AZURE_OPENAI_API_KEY=
